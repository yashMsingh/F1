# F1 Race Intelligence — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# PostgreSQL connection
POSTGRES_DB=f1_race_intelligence
POSTGRES_USER=f1user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy database URL (constructed from above, or override directly)
DATABASE_URL=postgresql://f1user:changeme@localhost:5432/f1_race_intelligence

# AI Narrative Layer Configuration
# Select active provider: 'groq' or 'openrouter'
LLM_PROVIDER=groq

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Global LLM Timeout
LLM_TIMEOUT_SECONDS=30.0
